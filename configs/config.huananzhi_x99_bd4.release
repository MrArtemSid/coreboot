# Full-ROM build for the Huananzhi X99-BD4 (Grantley uncore, Lynx Point PCH).
#
# Build-only: UncoreInitPeim from this board's blob directory has not been
# run on hardware. The provenance of the x99-bd4 blob set against the stock
# image is unverified.
CONFIG_ANY_TOOLCHAIN=y
CONFIG_VENDOR_HUANANZHI=y
CONFIG_BOARD_HUANANZHI_X99_BD4=y
CONFIG_CBFS_SIZE=0x800000
CONFIG_HAVE_IFD_BIN=y
CONFIG_HAVE_ME_BIN=y
CONFIG_HAVE_INTEL_UNCORE_BIN=y
CONFIG_ON_DEVICE_ROM_LOAD=y
CONFIG_PAYLOAD_NONE=y
