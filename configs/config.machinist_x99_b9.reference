# Reference build configuration for the Machinist X99 B9.
# Grantley uncore and Lynx Point PCH; existing hardware settings retained.
#
# Expected local inputs: 3rdparty/blobs/mainboard/machinist/x99-b9.
# The name correction does not revalidate firmware input provenance or
# TOLM/TSEG/InstallPeiMemory timing. These inputs must be supplied locally.
# Board sources and stock logs: https://github.com/MrArtemSid/coreboot_machinist_x99-b9
#
# Existing input hashes are identifiers, not proof of board ownership:
#   descriptor.bin   4096      sha256 9ee9d284bfec565e49bf5934e1d3800f8d57351844d7460bd09d281d44af9d4d
#   me.bin           8384512   sha256 04b63494d57ac598c026bff9fe7bb392e5129c5800ec5779dd247e57aec8f414
#   uncore.bin       605504    sha256 2b1709e0e0a5b22dcaf207b797bbfb65a4ff89cc6ff2633e3b5d314c23b0d81c
CONFIG_ANY_TOOLCHAIN=y
CONFIG_VENDOR_MACHINIST=y
CONFIG_BOARD_MACHINIST_X99_B9=y
CONFIG_CBFS_SIZE=0x800000
CONFIG_HAVE_INTEL_UNCORE_BIN=y