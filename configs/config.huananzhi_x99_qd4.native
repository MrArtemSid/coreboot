# Native-entry image for the Huananzhi X99-QD4 (Grantley uncore, Q87 PCH).
#
# UncoreInitPeim and the IntelSetup default come from
# 3rdparty/blobs/mainboard/huananzhi/x99-series; CBFS places the module at its
# PE ImageBase and PCD token 1 returns the ECAM base 0x80000000.
#
# Every input is this board's own file: descriptor, ME and uncore come from
# 3rdparty/blobs/mainboard/huananzhi/x99-series.  QD4 is the regression
# control for the D4M4 board.
#
# This is not a hardware-validated image for this port revision; earlier QD4
# observations stay scoped to their own blob and policy hashes.
CONFIG_ANY_TOOLCHAIN=y
CONFIG_VENDOR_HUANANZHI=y
CONFIG_BOARD_HUANANZHI_X99_QD4=y
CONFIG_CBFS_SIZE=0x800000
CONFIG_HAVE_IFD_BIN=y
CONFIG_HAVE_ME_BIN=y
CONFIG_HAVE_INTEL_UNCORE_BIN=y
CONFIG_ON_DEVICE_ROM_LOAD=y
