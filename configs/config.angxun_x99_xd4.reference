# Reference build for the Angxun X99-XD4 (Grantley uncore, Lynx Point PCH).
#
# Build-only: no board-native Uncore contract exists for this board yet.
# CONFIG_GRANTLEY_UNCORE_NATIVE_ENTRY is not selectable here (it depends on
# GRANTLEY_NATIVE_CONTRACT_QD4 || GRANTLEY_NATIVE_CONTRACT_D4M4) and the board
# selects GRANTLEY_UNCORE_REQUIRE_NATIVE_CONTRACT, so
# grantley_run_uncore_peim() refuses before the PE is parsed: stop reason
# GRANTLEY_STOP_CONTRACT, post code 0xe4, no entry, no DDR4 training.
#
# The refusal is what keeps this image honest.  On the pre-native path the
# module would be entered with no PCD provider, no PEI_DEPEX check and no
# image pin, and its first action is an unguarded LocatePpi(PCD) + Get64(1)
# whose call target the runner never supplies.  The blob is packaged for
# audit; the image is NOT a booting board image and must not be flashed as
# support.
#
# Inputs come from 3rdparty/blobs/mainboard/angxun/x99-xd4, which is outside
# the pinned blob tree (the gitlink is deliberately unchanged).  A fresh clone
# has no such directory and cannot build this fragment until it is supplied:
#   descriptor.bin   4096      sha256 9ee9d284bfec565e49bf5934e1d3800f8d57351844d7460bd09d281d44af9d4d
#   me.bin           8384512   sha256 04b63494d57ac598c026bff9fe7bb392e5129c5800ec5779dd247e57aec8f414
#   uncore.bin       605504    sha256 2b1709e0e0a5b22dcaf207b797bbfb65a4ff89cc6ff2633e3b5d314c23b0d81c
# All three are byte-identical to their regions in X9XD4006.bin; the uncore
# PE32 ImageBase is 0xffde6eb0, which is also its offset in that 16 MiB image.
CONFIG_ANY_TOOLCHAIN=y
CONFIG_VENDOR_ANGXUN=y
CONFIG_BOARD_ANGXUN_X99_XD4=y
CONFIG_CBFS_SIZE=0x800000
CONFIG_HAVE_INTEL_UNCORE_BIN=y
