# Native-entry image for the Angxun X99-XD4 (Grantley uncore, Lynx Point PCH).
#
# UncoreInitPeim and the IntelSetup default come from
# 3rdparty/blobs/mainboard/angxun/x99-xd4; CBFS places the module at its PE
# ImageBase.
#
# Every input is this board's own file: descriptor, ME and uncore come from
# 3rdparty/blobs/mainboard/angxun/x99-xd4.  No QD4 blob or policy is used.
#
# This is not a hardware-validated image: no X99-XD4 has been run with it, and
# the board's TOLM/TSEG/InstallPeiMemory timing is unmeasured.
CONFIG_ANY_TOOLCHAIN=y
CONFIG_VENDOR_ANGXUN=y
CONFIG_BOARD_ANGXUN_X99_XD4=y
CONFIG_CBFS_SIZE=0x800000
CONFIG_HAVE_IFD_BIN=y
CONFIG_HAVE_ME_BIN=y
CONFIG_HAVE_INTEL_UNCORE_BIN=y
CONFIG_ON_DEVICE_ROM_LOAD=y
