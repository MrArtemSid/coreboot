if PAYLOAD_CRABEFI

config PAYLOAD_FILE
	string "CrabEFI ELF binary"
	default "payloads/external/CrabEFI/CrabEFI/target/x86_64-unknown-none/debug/crabefi" if CRABEFI_DEBUG && !ARCH_RISCV_RV64
	default "payloads/external/CrabEFI/CrabEFI/target/x86_64-unknown-none/release/crabefi" if !ARCH_RISCV_RV64
	default "payloads/external/CrabEFI/CrabEFI/target/riscv64gc-unknown-none-elf/debug/crabefi" if CRABEFI_DEBUG
	default "payloads/external/CrabEFI/CrabEFI/target/riscv64gc-unknown-none-elf/release/crabefi"
	help
	  The path to the CrabEFI ELF binary.

config CRABEFI_RISCV_PAYLOAD_BASE
	string "RISC-V payload link base"
	depends on ARCH_RISCV_RV64
	default "0x402000000"
	help
	  Passed to the CrabEFI build as PAYLOAD_BASE (the riscv64-coreboot
	  linker script anchors the image there). Set per board: the SCR
	  QEMU clusters use 0x402000000 (L3, DRAM at 0x4_00000000) or
	  0x400000 (L2, DRAM at 0x0).

choice
	prompt "CrabEFI version"
	default CRABEFI_MASTER

config CRABEFI_MASTER
	bool "master"
	help
	  Use the latest master branch of CrabEFI.

config CRABEFI_REVISION
	bool "git revision"
	help
	  Use a specific git revision of CrabEFI.

endchoice

config CRABEFI_REPOSITORY
	string "CrabEFI git repository URL"
	default "https://github.com/ArthurHeymans/CrabEFI"
	help
	  The git repository URL for CrabEFI.

config CRABEFI_TAG_OR_REV
	string "CrabEFI git tag or revision"
	default "origin/master" if CRABEFI_MASTER
	default "" if CRABEFI_REVISION
	help
	  The git tag, branch name, or commit SHA-1 to use.
	  For branch names, prefix with "origin/" (e.g., "origin/master").

choice
	prompt "CrabEFI build type"
	default CRABEFI_RELEASE

config CRABEFI_DEBUG
	bool "Debug"
	help
	  Build CrabEFI with debug symbols and without optimizations.

config CRABEFI_RELEASE
	bool "Release"
	help
	  Build CrabEFI with optimizations.

endchoice

config CRABEFI_UI
	bool "Enable CrabEFI graphical UI"
	default y
	help
	  Enable CrabEFI's graphical UI, including mouse support and the
	  setup utility.

endif # PAYLOAD_CRABEFI
