config NORTHBRIDGE_INTEL_GRANTLEY
	bool
	select CPU_INTEL_GRANTLEY
	select SEPARATE_ROMSTAGE
	select ACPI_S1_NOT_SUPPORTED
	select DRAM_SUPPORT_DDR4
	select UDK_2017_BINDING
	select DRIVERS_EFI_VARIABLE_STORE
	select DRIVERS_INTEL_OC_MAILBOX

if NORTHBRIDGE_INTEL_GRANTLEY

config ECAM_MMCONF_BASE_ADDRESS
	default 0x80000000

config ECAM_MMCONF_BUS_NUMBER
	default 256

# The Uncore reference code ends the IIO MMIOL window at 0xfbffffff.
config DOMAIN_RESOURCE_32BIT_LIMIT
	default 0xfc000000

config DCACHE_RAM_BASE
	hex
	default 0xfe100000

config DCACHE_RAM_SIZE
	hex
	default 0x100000

config HAVE_INTEL_UNCORE_BIN
	bool "Add Intel Grantley Uncore binary (UncoreInitPeim)"
	default n
	help
	  Select this option to add Intel Grantley Uncore reference code
	  (UncoreInitPeim) to CBFS for DDR4 memory and uncore initialization.

config INTEL_UNCORE_BIN_FILE
	string "Intel Grantley Uncore binary path and filename"
	depends on HAVE_INTEL_UNCORE_BIN
	default "3rdparty/blobs/mainboard/\$(MAINBOARDDIR)/uncore.bin"
	help
	  The path and filename of the UncoreInitPeim binary to add to CBFS.

config GRANTLEY_INTELSETUP_FILE
	string "IntelSetup default variable path and filename"
	depends on HAVE_INTEL_UNCORE_BIN
	default "3rdparty/blobs/mainboard/\$(MAINBOARDDIR)/intelsetup.bin"
	help
	  Raw IntelSetup (SYSTEM_CONFIGURATION) payload served to
	  UncoreInitPeim. When the file does not exist, the variable is not
	  provided and the module uses its built-in defaults.

config GRANTLEY_UNCORE_RC_SERIAL
	bool "Enable UncoreInitPeim serial debug output"
	depends on HAVE_INTEL_UNCORE_BIN
	default y
	help
	  Set serialDebugMsgLvl in the IntelSetup payload to 1 so the
	  Uncore reference code prints its own messages on COM1. Has no
	  effect when the board does not set
	  GRANTLEY_INTELSETUP_SERIAL_LEVEL_OFFSET.

config GRANTLEY_INTELSETUP_SERIAL_LEVEL_OFFSET
	hex
	depends on HAVE_INTEL_UNCORE_BIN
	default 0x0
	help
	  Offset of serialDebugMsgLvl in the board's IntelSetup payload,
	  or 0 when it is not known.

config DCACHE_BSP_STACK_SIZE
	hex
	default 0x10000
	help
	  Stack for coreboot's own romstage code; the vendor PEIM runs on
	  the descending stack the romstage reserves for it.

config FIXED_MCHBAR_MMIO_BASE
	default 0xfed10000

config FIXED_DMIBAR_MMIO_BASE
	default 0xfed18000

config FIXED_EPBAR_MMIO_BASE
	default 0xfed19000

endif
