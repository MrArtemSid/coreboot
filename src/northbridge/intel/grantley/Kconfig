config NORTHBRIDGE_INTEL_GRANTLEY
	bool
	select CPU_INTEL_GRANTLEY
	select SEPARATE_ROMSTAGE
	select ACPI_S1_NOT_SUPPORTED
	select DRAM_SUPPORT_DDR4
	select UDK_2017_BINDING
	select DRIVERS_EFI_VARIABLE_STORE
	select DRIVERS_INTEL_OC_MAILBOX
	select CACHE_MRC_SETTINGS

if NORTHBRIDGE_INTEL_GRANTLEY

# Two slots of the module's 136 KiB training export plus the slot metadata.
config MRC_SETTINGS_CACHE_SIZE
	hex
	default 0x50000

config ECAM_MMCONF_BASE_ADDRESS
	default 0x80000000

config ECAM_MMCONF_BUS_NUMBER
	default 256

config DCACHE_RAM_BASE
	hex
	default 0xfe100000

config DCACHE_RAM_SIZE
	hex
	default 0x100000

config HAVE_INTEL_UNCORE_BIN
	bool "Add Intel Grantley Uncore binary (UncoreInitPeim)"
	default n
	help
	  Select this option to add the Intel Grantley Uncore binary
	  (UncoreInitPeim) to CBFS for DDR4 memory and uncore initialization.

config INTEL_UNCORE_BIN_FILE
	string "Intel Grantley Uncore binary path and filename"
	depends on HAVE_INTEL_UNCORE_BIN
	default "3rdparty/blobs/mainboard/\$(MAINBOARDDIR)/uncore.bin"
	help
	  The path and filename of the UncoreInitPeim binary to add to CBFS.

config GRANTLEY_INTELSETUP_FILE
	string "IntelSetup default variable path and filename"
	depends on HAVE_INTEL_UNCORE_BIN
	default "3rdparty/blobs/mainboard/\$(MAINBOARDDIR)/intelsetup.bin"
	help
	  Raw IntelSetup payload, the setup structure served to
	  UncoreInitPeim. When the file does not exist, the variable is not
	  provided and the module uses its built-in defaults.

config GRANTLEY_UNCORE_RC_SERIAL
	bool "Enable UncoreInitPeim serial debug output"
	depends on HAVE_INTEL_UNCORE_BIN
	default y
	help
	  Set serialDebugMsgLvl in the IntelSetup payload to 1 so the
	  UncoreInitPeim prints its own messages on COM1. Has no
	  effect when the board does not set
	  GRANTLEY_INTELSETUP_SERIAL_LEVEL_OFFSET.

config GRANTLEY_INTELSETUP_SERIAL_LEVEL_OFFSET
	hex
	depends on HAVE_INTEL_UNCORE_BIN
	default 0x0
	help
	  Offset of serialDebugMsgLvl in the board's IntelSetup payload,
	  or 0 when it is not known.

config GRANTLEY_INTELSETUP_FAST_BOOT_COLD_OFFSET
	hex
	depends on HAVE_INTEL_UNCORE_BIN && CACHE_MRC_SETTINGS
	default 0x1209
	help
	  Offset of attemptFastBootCold in the board's IntelSetup payload, or 0
	  to leave the byte alone. The field moves with the payload layout, so a
	  board whose payload is not the 6090-byte one must set this to 0 until
	  the offset is read from its own setup forms: writing a policy byte at
	  the wrong offset is silent and changes memory init behaviour.

config GRANTLEY_PLATFORM_TYPE
	hex
	depends on HAVE_INTEL_UNCORE_BIN
	default 0x0
	help
	  EFI_PLATFORM_TYPE the memory initializer is told it runs on, stored as
	  BoardId in the PlatformInfo HOB. It selects the QPI EPARAM tables and,
	  for the HEDT values 0x13-0x15, clears the ECC policy outright, so a
	  server board must not inherit a HEDT type. The 2-socket CRB reference
	  value is 0x00; 0x13 is the single-socket HEDT type.

config GRANTLEY_UNCORE_TRACE
	bool "Log the PEI services the memory initializer calls"
	depends on HAVE_INTEL_UNCORE_BIN
	default n
	help
	  Print every call the opaque memory initializer makes into the PEI
	  services table, with the address it called from. A release build of
	  the module carries no output of its own, so without this a stall
	  inside it cannot be told apart from slow DRAM training. Each slot has
	  its own message budget; exceeding it only stops that slot's messages.

config GRANTLEY_ME_UMA
	bool "Hand the ME UMA over to the ME during memory init"
	depends on HAVE_INTEL_UNCORE_BIN && SOUTHBRIDGE_INTEL_LYNXPOINT
	help
	  Provide the ME UMA interface to UncoreInitPeim, so the memory
	  initializer reserves the UMA the ME asks for, programs the IIO
	  ME range and sends DRAM Init Done to the ME.

	  Without it the interface reports no ME UMA and skips the handoff,
	  leaving the ME in the state it reached on its own.
	  This is experimental: leave it disabled unless the ME region on
	  the board is known to come up in normal operation.

config DCACHE_BSP_STACK_SIZE
	hex
	default 0x10000
	help
	  Stack for coreboot's own romstage code; the vendor PEIM runs on
	  the descending stack the romstage reserves for it.

config FIXED_MCHBAR_MMIO_BASE
	default 0xfed10000

config FIXED_DMIBAR_MMIO_BASE
	default 0xfed18000

config FIXED_EPBAR_MMIO_BASE
	default 0xfed19000

endif
