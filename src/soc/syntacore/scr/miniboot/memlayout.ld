	DRAM_START(SCR_DDR_BASE)
	BOOTBLOCK(SCR_DDR_BASE, 128K)
	RAMSTAGE(SCR_DDR_BASE + 128K, 2M)
	PRERAM_CBMEM_CONSOLE(SCR_DDR_BASE + 128K + 2M, 8K)
	FMAP_CACHE(SCR_DDR_BASE + 128K + 2M + 8K, 2K)
	CBFS_MCACHE(SCR_DDR_BASE + 128K + 2M + 10K, 10K)
	CAR_STACK(SCR_DDR_BASE + 3M, 4K * CONFIG_MAX_CPUS)
	MEM_STACK(SCR_DDR_BASE + 4M, 4K * CONFIG_MAX_CPUS)
	OPENSBI(SCR_OPENSBI_BASE, 1M)
	REGION(flash, SCR_CBFS_BASE, CONFIG_ROM_SIZE, 0)
