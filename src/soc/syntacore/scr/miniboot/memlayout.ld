	DRAM_START(SCR_DDR_BASE)
#if ENV_BOOTBLOCK
	BOOTBLOCK(SCR_DDR_BASE, 128K)
#else
	OPENSBI(SCR_OPENSBI_BASE, 2M)
#endif
	RAMSTAGE(SCR_RAMSTAGE_BASE, 2M)
	PRERAM_CBMEM_CONSOLE(SCR_RAMSTAGE_BASE + 2M, 8K)
	FMAP_CACHE(SCR_RAMSTAGE_BASE + 2M + 8K, 2K)
	CBFS_MCACHE(SCR_RAMSTAGE_BASE + 2M + 10K, 10K)
	CAR_STACK(SCR_RAMSTAGE_BASE + 2M + 64K, 4K * CONFIG_MAX_CPUS)
	MEM_STACK(SCR_RAMSTAGE_BASE + 2M + 128K, 4K * CONFIG_MAX_CPUS)
	REGION(flash, SCR_CBFS_BASE, CONFIG_ROM_SIZE, 0)
