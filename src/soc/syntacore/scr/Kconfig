config SOC_SYNTACORE_SCR
	bool
	select ARCH_RISCV_RV64
	select ARCH_RISCV_S
	select ARCH_RISCV_U
	select ARCH_RISCV_PMP
	select ARCH_BOOTBLOCK_RISCV
	select ARCH_VERSTAGE_RISCV
	select ARCH_ROMSTAGE_RISCV
	select ARCH_RAMSTAGE_RISCV
	select RISCV_USE_ARCH_TIMER
	select RISCV_HAS_OPENSBI
	select RISCV_GET_HART_COUNT_AT_RUNTIME
	select FLATTENED_DEVICE_TREE
	select RISCV_DTS
	select DRIVERS_UART_8250MEM_32
	select UART_OVERRIDE_REFCLK
	select MISSING_BOARD_RESET

config SEPARATE_ROMSTAGE
	default n if SOC_SYNTACORE_SCR

if SOC_SYNTACORE_SCR

choice SCR_PLATFORM
	prompt "SCR platform"
	default SCR9_L3
	help
	  CPU family and cluster type of the target. The platform selects the
	  feature booleans below, which the C code, the devicetree sources and
	  the Makefiles test; the platform itself is the only user-visible
	  selection.

config SCR9_L2
	bool "SCR9 L2"
	select SCR_CPU_SCR9
	select SCR_CLUSTER_L2

config SCR9_L3
	bool "SCR9 L3"
	select SCR_CPU_SCR9
	select SCR_CLUSTER_L3

config SCR7_L2
	bool "SCR7 L2"
	select SCR_CPU_SCR7
	select SCR_CLUSTER_L2

config SCR7_L3
	bool "SCR7 L3"
	select SCR_CPU_SCR7
	select SCR_CLUSTER_L3

endchoice

# Derived from the SCR_PLATFORM choice. They stay ordinary booleans because
# the C code, devicetree macros and Makefiles test these exact names.
config SCR_CPU_SCR9
	bool

config SCR_CPU_SCR7
	bool

config SCR_CLUSTER_L2
	bool

config SCR_CLUSTER_L3
	bool

config SCR_HAL_PLATFORM
	string
	default "scr9_l3" if SCR_CPU_SCR9 && SCR_CLUSTER_L3
	default "scr9_l2" if SCR_CPU_SCR9 && SCR_CLUSTER_L2
	default "scr7_l3" if SCR_CPU_SCR7 && SCR_CLUSTER_L3
	default "scr7_l2"

config SCR_HAL_DIR
	string "External SCR-HAL source directory"
	default ""

config RISCV_ARCH
	string "RISC-V ISA"
	default "rv64gc_sscofpmf_zfhmin_zihintpause_zba_zbb_zbc_zbs" if SCR_CPU_SCR9 && SCR_CLUSTER_L3
	default "rv64gc_zba_zbb_zbc_zbs"

config RISCV_ABI
	default "lp64d"

config RISCV_CODEMODEL
	default "medany"

config MAX_CPUS
	default 8

config RISCV_WORKING_HARTID
	default 0

config MEMLAYOUT_LD_FILE
	default "src/soc/syntacore/scr/memlayout.ld"

config OPENSBI_PLATFORM
	default "generic"

config OPENSBI_SOURCE_DIR
	default "3rdparty/syntacore/opensbi"

config OPENSBI_TEXT_START
	default 0x404000000 if SCR_CLUSTER_L3
	default 0x4000000

config CRABEFI_PAYLOAD_BASE
	default 0x410000000 if SCR_CLUSTER_L3
	default 0x10000000

config UBOOT_TEXT_BASE
	default 0x410000000 if SCR_CLUSTER_L3
	default 0x10000000

config UBOOT_DEFCONFIG
	default "scr_rv64_l3_cluster_opensbi_defconfig" if SCR_CLUSTER_L3
	default "scr_rv64_l2_cluster_opensbi_defconfig"

config UBOOT_REPO_URL
	default "https://github.com/syntacore/u-boot.git"

config UBOOT_BRANCH_OR_TAG
	default "sc/2026.04"

endif
