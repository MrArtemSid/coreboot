config SOC_SYNTACORE_SCR
	bool
	select SOC_SYNTACORE_COMMON

if SOC_SYNTACORE_SCR

choice SCR_PLATFORM
	prompt "SCR platform"
	default SCR9_L3
	help
	  CPU family and cluster type of the target. The platform selects the
	  feature booleans below, which the C code, the devicetree sources and
	  the Makefiles test; the platform itself is the only user-visible
	  selection.

config SCR9_L2
	bool "SCR9 L2"
	select SCR_CPU_SCR9
	select SCR_CLUSTER_L2

config SCR9_L3
	bool "SCR9 L3"
	select SCR_CPU_SCR9
	select SCR_CLUSTER_L3

config SCR7_L2
	bool "SCR7 L2"
	select SCR_CPU_SCR7
	select SCR_CLUSTER_L2

config SCR7_L3
	bool "SCR7 L3"
	select SCR_CPU_SCR7
	select SCR_CLUSTER_L3

endchoice

config SCR_OCRAM_BASE
	hex
	default 0x02000000 if SCR_CLUSTER_L3
	default 0xffffffffffff0000
	help
	  Base of the on-chip SRAM that runs all pre-RAM code and the hart
	  stacks. It has to match PLF_OCRAM_BASE of the SCR-HAL platform
	  selected by the CPU and cluster options; the HAL build asserts that.
	  No prompt: changing it alone produces an image that faults at the
	  reset vector.

config SCR_RESET_VECTOR
	hex "SCR reset vector address"
	default 0x02000200 if SCR_CLUSTER_L3
	default 0xffffffffffffff00
	help
	  Address the cluster resets to. L3 enters the bootblock at this
	  address inside OCRAM, so the bootblock load offset follows it; the
	  default is OCRAM base + 0x200. L2 has no reset entry of its own: the
	  bootblock carries a jump into the code there in the last 256 bytes
	  of the 64 KiB OCRAM, so the value must stay at OCRAM base + size -
	  0x100. The linker script asserts both relationships against
	  SCR_OCRAM_BASE and SCR_OCRAM_SIZE.

config SCR_HAL_PLATFORM
	string "SCR-HAL platform"
	default "scr9_l3" if SCR_CPU_SCR9 && SCR_CLUSTER_L3
	default "scr9_l2" if SCR_CPU_SCR9 && SCR_CLUSTER_L2
	default "scr7_l3" if SCR_CPU_SCR7 && SCR_CLUSTER_L3
	default "scr7_l2"
	help
	  SCR-HAL platform directory that describes the selected CPU and
	  cluster. Its PLF_* definitions drive the HAL objects, the MMIO
	  accessors and, through PLF_MEM_BASE, the linker layout, so the
	  value has to name a platform of the SCR-HAL tree; an unknown name
	  fails the build on its missing plf.h.

config RISCV_ARCH
	string "RISC-V ISA"
	default "rv64gc_sscofpmf_zfhmin_zihintpause_zba_zbb_zbc_zbs" if SCR_CPU_SCR9 && SCR_CLUSTER_L3
	default "rv64gc_zba_zbb_zbc_zbs"

endif
