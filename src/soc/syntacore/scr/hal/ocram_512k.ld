	SRAM_START(SCR_OCRAM_BASE)
	BOOTBLOCK(SCR_OCRAM_BASE + SCR_OCRAM_BOOTBLOCK_OFFSET,
		  128K - SCR_OCRAM_BOOTBLOCK_OFFSET)
	PRERAM_CBMEM_CONSOLE(SCR_OCRAM_BASE + 128K, 8K)
	FMAP_CACHE(SCR_OCRAM_BASE + 136K, 2K)
	CBFS_MCACHE(SCR_OCRAM_BASE + 138K, 10K)
	CAR_STACK(SCR_OCRAM_BASE + 148K, 4K * CONFIG_MAX_CPUS)
	_ = ASSERT(_ecar_stack - SCR_OCRAM_BASE <= CONFIG_SCR_OCRAM_SIZE,
		   "Pre-RAM regions exceed OCRAM");
