	def_bool y
	select SOC_SYNTACORE_SCR9_L2

endif # BOARD_SYNTACORE_SCR9_L2

if BOARD_SYNTACORE_SCR7_L2

config BOARD_SYNTACORE_SCR_L2_CLUSTER
	def_bool y
	select SOC_SYNTACORE_SCR7_L2

endif # BOARD_SYNTACORE_SCR7_L2

if BOARD_SYNTACORE_SCR5_RV64

config BOARD_SYNTACORE_SCR_L2_CLUSTER
	def_bool y
	select SOC_SYNTACORE_SCR5_RV64

endif # BOARD_SYNTACORE_SCR5_RV64

if BOARD_SYNTACORE_SCR_L2_CLUSTER

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select BOARD_ROMSIZE_KB_16384

config MAINBOARD_DIR
	default "syntacore/scr_l2_cluster"

config MAINBOARD_PART_NUMBER
	default "SCR9 L2 cluster" if BOARD_SYNTACORE_SCR9_L2
	default "SCR7 L2 cluster" if BOARD_SYNTACORE_SCR7_L2
	default "SCR5 RV64 L2 cluster" if BOARD_SYNTACORE_SCR5_RV64

config RISCV_ARCH
	string
	default "rv64imafd"

config RISCV_ABI
	string
	default "lp64d"

config RISCV_CODEMODEL
	string
	default "medany"

config SCR9_L2_QEMU_VIRTIO
	bool "Describe the SC-DT QEMU virtio-mmio transports in the SCR9 L2 device tree"
	depends on BOARD_SYNTACORE_SCR9_L2
	default n
	help
	  The SC-DT QEMU scr9_l2 machine attaches eight virtio-mmio transports
	  at 0x00ffffff_ff100000..0x00ffffff_ff107000 that the real VCU118
	  prototype lacks. Enable to build the board device tree from
	  vcu118_scr9_l2_qemu.dts, which adds the transport nodes plus an
	  opensbi-domains region so the trusted-domain payload can reach them.

config RISCV_DTS_FILE
	string
	default "src/mainboard/syntacore/scr_l2_cluster/vcu118_scr9_l2_qemu.dts" if SCR9_L2_QEMU_VIRTIO
	default "src/mainboard/syntacore/scr_l2_cluster/scr9_l2.dts" if BOARD_SYNTACORE_SCR9_L2
	default "3rdparty/linux/arch/riscv/boot/dts/syntacore/vcu118_scr7_l2.dts" if BOARD_SYNTACORE_SCR7_L2
	default "3rdparty/linux/arch/riscv/boot/dts/syntacore/vcu118_scr5_rv64_l2.dts" if BOARD_SYNTACORE_SCR5_RV64

endif # BOARD_SYNTACORE_SCR_L2_CLUSTER
