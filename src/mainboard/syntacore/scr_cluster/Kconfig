config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select BOARD_ROMSIZE_KB_16384
	select SOC_SYNTACORE_SCR9_L3 if BOARD_SYNTACORE_SCR9_L3
	select SOC_SYNTACORE_SCR9_L2 if BOARD_SYNTACORE_SCR9_L2
	select SOC_SYNTACORE_SCR7_L3 if BOARD_SYNTACORE_SCR7_L3
	select SOC_SYNTACORE_SCR7_L2 if BOARD_SYNTACORE_SCR7_L2
	select SOC_SYNTACORE_SCR5_RV64 if BOARD_SYNTACORE_SCR5_RV64
	select SOC_SYNTACORE_SCR5_RV32 if BOARD_SYNTACORE_SCR5_RV32

config MAINBOARD_DIR
	default "syntacore/scr_cluster"

config MAINBOARD_PART_NUMBER
	default "SCR9 L3 cluster" if BOARD_SYNTACORE_SCR9_L3
	default "SCR7 L3 cluster" if BOARD_SYNTACORE_SCR7_L3
	default "SCR9 L2 cluster" if BOARD_SYNTACORE_SCR9_L2
	default "SCR7 L2 cluster" if BOARD_SYNTACORE_SCR7_L2
	default "SCR5 RV64 L2 cluster" if BOARD_SYNTACORE_SCR5_RV64
	default "SCR5 RV32 L2 cluster" if BOARD_SYNTACORE_SCR5_RV32

config RISCV_ARCH
	string
	default "rv32imafd" if BOARD_SYNTACORE_SCR5_RV32
	default "rv64imafd"

config RISCV_ABI
	string
	default "ilp32d" if BOARD_SYNTACORE_SCR5_RV32
	default "lp64d"

config RISCV_CODEMODEL
	string
	default "medany"

config MEMLAYOUT_LD_FILE
	default "src/mainboard/syntacore/scr_cluster/memlayout_l3.ld" if SOC_SYNTACORE_L3_CLUSTER
	default "src/mainboard/syntacore/scr_cluster/memlayout_l2.ld"

config SCR9_L2_QEMU_VIRTIO
	bool "Describe the SC-DT QEMU virtio-mmio transports in the SCR9 L2 device tree"
	depends on BOARD_SYNTACORE_SCR9_L2
	default n
	help
	  The SC-DT QEMU scr9_l2 machine attaches eight virtio-mmio transports
	  at 0x00ffffff_ff100000..0x00ffffff_ff107000 that the real VCU118
	  prototype lacks. Enable to build the board device tree from
	  vcu118_scr9_l2_qemu.dts, which adds the transport nodes plus an
	  opensbi-domains region so the trusted-domain payload can reach them.

config SCR9_L3_QEMU_VIRTIO
	bool "Describe the SC-DT QEMU virtio-mmio transports in the SCR9 L3 device tree"
	depends on BOARD_SYNTACORE_SCR9_L3
	default n
	help
	  The SC-DT QEMU scr9_l3 machine attaches eight virtio-mmio transports
	  at 0xff020000..0xff027000 that the real VCU118 prototype lacks. Enable
	  to build the board device tree from vcu118_scr9_l3_qemu.dts, which
	  adds the transport nodes plus an opensbi-domains region so the
	  trusted-domain payload can reach them.

config RISCV_DTS_FILE
	string
	default "src/mainboard/syntacore/scr_cluster/dts/vcu118_scr9_l2_qemu.dts" if SCR9_L2_QEMU_VIRTIO
	default "src/mainboard/syntacore/scr_cluster/dts/vcu118_scr9_l3_qemu.dts" if SCR9_L3_QEMU_VIRTIO
	default "src/mainboard/syntacore/scr_cluster/dts/scr9_l2.dts" if BOARD_SYNTACORE_SCR9_L2
	default "src/mainboard/syntacore/scr_cluster/dts/scr7_l3.dts" if BOARD_SYNTACORE_SCR7_L3
	default "3rdparty/linux/arch/riscv/boot/dts/syntacore/vcu118_scr9_l3.dts" if BOARD_SYNTACORE_SCR9_L3
	default "3rdparty/linux/arch/riscv/boot/dts/syntacore/vcu118_scr7_l2.dts" if BOARD_SYNTACORE_SCR7_L2
	default "3rdparty/linux/arch/riscv/boot/dts/syntacore/vcu118_scr5_rv64_l2.dts" if BOARD_SYNTACORE_SCR5_RV64
	default "3rdparty/linux/arch/riscv/boot/dts/syntacore/vcu118_scr5_rv32_l2.dts" if BOARD_SYNTACORE_SCR5_RV32
