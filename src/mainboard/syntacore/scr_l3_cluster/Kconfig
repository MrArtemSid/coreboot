if BOARD_SYNTACORE_SCR9_L3

config BOARD_SYNTACORE_SCR_L3_CLUSTER
	def_bool y
	select SOC_SYNTACORE_SCR9_L3

endif # BOARD_SYNTACORE_SCR9_L3

if BOARD_SYNTACORE_SCR7_L3

config BOARD_SYNTACORE_SCR_L3_CLUSTER
	def_bool y
	select SOC_SYNTACORE_SCR7_L3

endif # BOARD_SYNTACORE_SCR7_L3

if BOARD_SYNTACORE_SCR_L3_CLUSTER

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select BOARD_ROMSIZE_KB_16384

config MAINBOARD_DIR
	default "syntacore/scr_l3_cluster"

config MAINBOARD_PART_NUMBER
	default "SCR9 L3 cluster" if BOARD_SYNTACORE_SCR9_L3
	default "SCR7 L3 cluster" if BOARD_SYNTACORE_SCR7_L3

config RISCV_ARCH
	string
	default "rv64imafd"

config RISCV_ABI
	string
	default "lp64d"

config RISCV_CODEMODEL
	string
	default "medany"

config SCR9_L3_QEMU_VIRTIO
	bool "Describe the SC-DT QEMU virtio-mmio transports in the SCR9 L3 device tree"
	depends on BOARD_SYNTACORE_SCR9_L3
	default n
	help
	  The SC-DT QEMU scr9_l3 machine attaches eight virtio-mmio transports
	  at 0xff020000..0xff027000 that the real VCU118 prototype lacks. Enable
	  to build the board device tree from vcu118_scr9_l3_qemu.dts, which
	  adds the transport nodes plus an opensbi-domains region so the
	  trusted-domain payload can reach them.

config RISCV_DTS_FILE
	string
	default "src/mainboard/syntacore/scr_l3_cluster/vcu118_scr9_l3_qemu.dts" if SCR9_L3_QEMU_VIRTIO
	default "3rdparty/linux/arch/riscv/boot/dts/syntacore/vcu118_scr9_l3.dts" if BOARD_SYNTACORE_SCR9_L3
	default "src/mainboard/syntacore/scr_l3_cluster/scr7_l3.dts" if BOARD_SYNTACORE_SCR7_L3

endif # BOARD_SYNTACORE_SCR_L3_CLUSTER
