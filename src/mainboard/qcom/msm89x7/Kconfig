config BOARD_QCOM_MSM89X7_COMMON
	def_bool n

config BOARD_QCOM_MSM89X7_GENERIC
	select BOARD_QCOM_MSM89X7_COMMON

config BOARD_QCOM_MSM89X7_SANTONI
	select BOARD_QCOM_MSM89X7_COMMON

if BOARD_QCOM_MSM89X7_COMMON

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select BOARD_ROMSIZE_KB_16384
	select BOOTBLOCK_CUSTOM
	select BOOT_DEVICE_NOT_SPI_FLASH
	select SOC_QUALCOMM_MSM89X7

config MAINBOARD_DIR
	default "qcom/msm89x7"

config MAINBOARD_PART_NUMBER
	default "MSM89x7 generic" if BOARD_QCOM_MSM89X7_GENERIC
	default "Redmi 4X (santoni)" if BOARD_QCOM_MSM89X7_SANTONI

config MAINBOARD_VENDOR
	default "Qualcomm"

# Amount of DRAM hidden at the top of the address space by TrustZone and
# the hypervisor. Only used if the device tree handed over by the primary
# bootloader does not provide a /memory node.
config MSM89X7_DRAM_SIZE_MB
	default 2048 if BOARD_QCOM_MSM89X7_GENERIC
	default 3072 if BOARD_QCOM_MSM89X7_SANTONI

endif # BOARD_QCOM_MSM89X7_COMMON
